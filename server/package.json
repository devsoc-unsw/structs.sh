{
  "name": "server",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "ts-node-dev src/index.ts",
    "tsc": "npm run typecheck:server && npm run typecheck:migrations",
    "typecheck:server": "tsc -p tsconfig.json",
    "typecheck:migrations": "tsc -p migrations/tsconfig.json",
    "lint": "eslint --ext .js,.ts src/",
    "lint-fix": "eslint --fix --ext .js,.ts src/",
    "migrate:create": "node-pg-migrate create -j ts --ignore-pattern 'tsconfig[.]json'",
    "migrate:up": "node-pg-migrate up --ignore-pattern 'tsconfig[.]json'",
    "migrate:down": "node-pg-migrate down --ignore-pattern 'tsconfig[.]json'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.49.0",
    "node-pg-migrate": "^9.0.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2",
    "vitest": "^4.1.10"
  }
}
